# automacao/.env
# Copie para .env e ajuste os valores
# IMPORTANTE: AUTOMACAO_API_KEY deve ser IGUAL ao AUTOMACAO_API_KEY do .env do Laravel

AUTOMACAO_API_KEY=gere-uma-chave-segura-aqui

# Credenciais FV (só para teste local — diagnostico_proprietario.py)
AUTOMACAO_FV_USUARIO=
AUTOMACAO_FV_SENHA=

AUTOMACAO_DB_PATH=/tmp/automacao_db/jobs.db
AUTOMACAO_SCREENSHOT_DIR=/tmp/automacao_screenshots
